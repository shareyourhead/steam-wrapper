// Scroll down to USER-DEFINED SECTION!

{
  "device":{
    "name":"Logitech G502 X Lightspeed",
    "id":"046d:409f" // This is the wireless ID. It is different when plugged in.
  },
  
  // inputs acquired via evtest
  // see https://docs.rs/evdev/latest/evdev/struct.KeyCode.html for acceptable io values
  "input":{
    "left_click":"BTN_LEFT",
    "right_click":"BTN_RIGHT",
    "middle_click":"BTN_MIDDLE",
    "back_thumb":"BTN_SIDE",
    "forward_thumb":"BTN_EXTRA",
    "sniper":"BTN_FORWARD",
    "G7":"BTN_BACK",
    "G8":"BTN_TASK",
    "G9":280,
    "analog_up":{ "axis":"REL_Y", "delta":-1, "noisy": true },
    "analog_down":{ "axis":"REL_Y", "delta":1, "noisy": true },
    "analog_left":{ "axis":"REL_X", "delta":-1, "noisy": true },
    "analog_right":{ "axis":"REL_X", "delta":1, "noisy": true },
    "scroll_up":{ "axis":"REL_WHEEL", "delta":1 },
    "scroll_down":{ "axis":"REL_WHEEL", "delta":-1 },
    "scroll_left":{ "axis":"REL_HWHEEL", "delta":-1 },
    "scroll_right":{ "axis":"REL_HWHEEL", "delta":1 }
  },

  "output":{
    // DO NOT CHANGE THIS! These are the game's default controls.
    // Instead, add entries to "rebound" mirroring the structure found here.
    "default":{//DEV program should be able to run without a default section as long as all used outputs have mappings
      "walking":{//handled
        "move_up":"KEY_W",
        "move_down":"KEY_S",
        "move_left":"KEY_A",
        "move_right":"KEY_D",
        "start_climbing":"BTN_LEFT",
        "speed_walk":"KEY_LEFTSHIFT",
        "take_a_running_start":"KEY_LEFTCTRL",
        "jump":"KEY_SPACE",
        "recall_climbot":"KEY_Q"
      },
      "walking_and_climbing": {//handled
        "interact":"KEY_E",
        "scope_the_wall":"KEY_TAB",
        "grab_rope":"KEY_LEFTSHIFT"
      },
      "climbing": {//handled
        "move_up":"KEY_W",
        "move_down":"KEY_S",
        "move_left":"KEY_A",
        "move_right":"KEY_D",
        "climb": "BTN_LEFT",
        "cancel_last_action":"BTN_RIGHT",
        "recover_stamina": "KEY_Q",
        "fall_rewind": "KEY_R",//get good
        "manual_limb_selection": "KEY_SPACE"
      },
      "rappelling": {//need to figure out what this even is
        "jump": "KEY_SPACE",
        "slide": "KEY_LEFTALT"
      },
      "manual_limb_selection": {//handled
        "left_hand": "KEY_W",
        "right_hand": "KEY_D",
        "right_foot": "KEY_S",
        "left_foot": "KEY_A"
      },
      "quick_actions": {//handled
        "action_1": "KEY_1",
        "action_2": "KEY_2",
        "action_3": "KEY_3",
        "action_4": "KEY_4",
        "alternate_quick_actions": "KEY_X"
      },
      "remote_view": {//handled
        "display_route": "KEY_LEFTALT",
        "check_map": "KEY_T",
        "raise_the_camera": "KEY_E",
        "lower_the_camera": "KEY_Q"
        //HARD-BINDS: scroll wheel zooms in and out.
      },
      "backpack": {//handled
        "use": "KEY_E",
        "compost": "KEY_Q",
        "shake_up_bag": "KEY_C",// Doing this by shaking the mouse would be so cool!!!
        "grab": "KEY_LEFT",
        "rotate_left": "KEY_A",
        "rotate_right": "KEY_D"
      }
      //HARD-BINDS: esc pauses/exits, right click exits.
    },
/****************************************************************\
)                USER-DEFINED SECTION STARTS HERE                (
\****************************************************************/
    // see https://docs.rs/evdev/latest/evdev/struct.KeyCode.html for acceptable io values
    "rebinds": {//DEV program should be able to run without a rebinds section as long as all used outputs have mappings. //DEV warn user about rebinds at program start
      // Use the same structure here as in the "default" section above.
      "walking":{
        "jump":"climbing/manual_limb_selection",//DEV this will evaluate to same as default bind. Must make sure not to warn user about this one.
        "recall_climbot":"climbing/recover_stamina"
      },
      "climbing":{
        "move_up":"KEY_UP",
        "move_down":"KEY_DOWN",
        "move_left":"KEY_LEFT",
        "move_right":"KEY_RIGHT",
        "climb":"null",
        "cancel_last_action":"walking/move_up",
        "recover_stamina":"KEY_V"
      },
      "manual_limb_selection": {
        "left_hand": "KEY_L",
        "right_hand": "KEY_R",
        "right_foot": "KEY_BACKSLASH",
        "left_foot": "KEY_SLASH"
      },
      "remote_view": {
        "check_map": "walking_and_climbing/scope_the_wall",//Must test if this distinction exists in game. Can press check_map while on ground?
        "raise_the_camera": "walking/speed_walk",
        "lower_the_camera": "walking/take_a_running_start"
      },
      "backpack": {
        //"shake_up_bag": "KEY_C",// Doing this by shaking the mouse would be so cool!!!
        "use":"manual_limb_selection/right_hand",
        "compost":"climbing/recover_stamina",
        "rotate_left": "walking/take_a_running_start",
        "rotate_right": "walking/speed_walk"
      },
      "null":"KEY_0"
    }
  },

  "mappings": {

    // === MOVEMENT ===
    // "modifier": activates a named flag while held. output is sent while held,
    // but suppressed if any input in output_blocked_by is also held (those handle direction).
    // MOD_MOV gates MOD_ARM: arm-type mappings check blocked_by and skip if MOD_MOV is active.
    "sniper": { // Consider making forward_thumb into the movement button instead
      "type": "modifier",
      "flag": "MOD_MOV",
      "output": "walking/move_up",
      "output_blocked_by": ["left_click", "right_click"]
    },

    // === LIMBS ===
    // "conditional": cases are checked in order; first match fires. "also_held" and "none_held"
    // are additional per-case input guards on top of the flag check.
    // "arm": activates flag, sends primary while held (if given), sends down/up on press/release.
    //   passthrough: true re-emits the physical button so the game also sees the raw click.
    //   blocked_by: arm behavior is fully suppressed if that flag is active.
    "left_click": {
      "type": "conditional",
      "cases": [
        { "flag": "MOD_MOV", "also_held": ["right_click"], "output": "walking/move_down" },
        { "flag": "MOD_MOV",                               "output": "walking/move_left"  }
      ],
      "default": {
        "type": "arm",
        "flag": "MOD_ARM",
        "blocked_by": "MOD_MOV",
        "passthrough": true,
        "down": "manual_limb_selection/left_hand",
        "up":   "climbing/manual_limb_selection"
      }
    },

    "right_click": {
      "type": "conditional",
      "cases": [
        { "flag": "MOD_MOV", "none_held": ["left_click"], "output": "walking/move_right" }
      ],
      "default": {
        "type": "arm",
        "flag": "MOD_ARM",
        "blocked_by": "MOD_MOV",
        "down": "manual_limb_selection/right_hand", // also backpack/use via shared rebind
        "up":   "climbing/manual_limb_selection"
      }
    },

    "forward_thumb": { // also rotates in backpack via walking/speed_walk
      "type": "arm",
      "flag": "MOD_ARM",
      "blocked_by": "MOD_MOV",
      "primary": "walking/speed_walk",
      "down": "manual_limb_selection/left_foot",
      "up":   "climbing/manual_limb_selection"
    },

    // release_delay_ms: primary key is held this many ms after button release.
    // walking/jump = climbing/manual_limb_selection so releasing back_thumb
    // triggers a jump while running_start is still briefly active.
    "back_thumb": { // also rotates in backpack via walking/take_a_running_start
      "type": "arm",
      "flag": "MOD_ARM",
      "blocked_by": "MOD_MOV",
      "primary": "walking/take_a_running_start",
      "release_delay_ms": 50,
      "down": "manual_limb_selection/right_foot",
      "up":   "climbing/manual_limb_selection"
    },

    // "analog_intercept": passes REL events through normally; when flag is active,
    // suppresses passthrough and sends the intercepted output key instead.
    "analog_up":    { "type": "analog_intercept", "flag": "MOD_ARM", "intercepted": "climbing/move_up"    },
    "analog_down":  { "type": "analog_intercept", "flag": "MOD_ARM", "intercepted": "climbing/move_down"  },
    "analog_left":  { "type": "analog_intercept", "flag": "MOD_ARM", "intercepted": "climbing/move_left"  },
    "analog_right": { "type": "analog_intercept", "flag": "MOD_ARM", "intercepted": "climbing/move_right" },

    // === D-PAD ===
    // "dpad_scroll": sets the shared selection variable and taps it briefly (enough to show
    // the d-pad overlay but not long enough to commit). If the same direction is scrolled again
    // within the d-pad fade-out window, sends alternate instead of tapping selection again.
    "scroll_up":    { "type": "dpad_scroll", "selection": "quick_actions/action_3", "alternate": "quick_actions/alternate_quick_actions" },
    "scroll_down":  { "type": "dpad_scroll", "selection": "quick_actions/action_1", "alternate": "quick_actions/alternate_quick_actions" },
    "scroll_left":  { "type": "dpad_scroll", "selection": "quick_actions/action_2", "alternate": "quick_actions/alternate_quick_actions" },
    "scroll_right": { "type": "dpad_scroll", "selection": "quick_actions/action_4", "alternate": "quick_actions/alternate_quick_actions" },

    // "dpad_confirm": holds the current selection output for as long as the button is held.
    // If selection changes while held, the old key must be released before the new one fires.
    "middle_click": { "type": "dpad_confirm" },

    // === MAP / MISC ===
    // "short_long": fires "short" on quick release, "long" if held past threshold.
    // "phase_toggle": owns a bool that flips each press; sends phase_false when false, phase_true when true.
    // "long" uses a raw key code (KEY_ESC is not in the output table; implementation falls back to parse_key_code).
    "G9": {
      "type": "short_long",
      "short": {
        "type": "phase_toggle",
        "phase_false": "walking_and_climbing/scope_the_wall",
        "phase_true":  "remote_view/display_route"
      },
      "long": "KEY_ESC"
    },

    // "multi": presses all listed outputs simultaneously; game context determines which fires.
    "G8": { "type": "multi", "outputs": ["walking_and_climbing/interact", "backpack/use"] },

    // walking/recall_climbot is also rebound to climbing/recover_stamina, so both resolve to KEY_V.
    "G7": "climbing/recover_stamina"
  }
}
